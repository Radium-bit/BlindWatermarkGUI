## 【注意】 此文件会覆盖DEV.ENV的同名内容，敬请留意

#构建时输出文件名是否包括 Git Hash 
INCLUDE_GIT_HASH=true
# 程序构建版本号
BUILD_VERSION='0.2.11'
# 是否启用控制台调试
ENABLE_CONSOLE_DEBUG=true
# 是否启用优化模式（0：无优化调试用，1：基础优化，2：深度优化）
OPTIMIZE=1
# 是否启用压缩
ENABLE_COMPRESS=true
# 压缩等级
# 0-9，越高压缩率越高，但压缩时间也越长
COMPRESS_LEVEL=6
# 是否额外打包Protable格式
INCLUDE_PROTABLE=true
# 是否额外打包安装程序格式
INCLUDE_INSTALLER=true
# 额外打包时，是否同时打包OnefileEXE格式
INCLUDE_ONEFILE=true
# 程序GUID，用于安装后识别，建议每个分支采用独立的GUID
PROGRAM_GUID='375ed30c-67dd-4a92-aae0-2f3e6e4da8dd'

# ── 7z 压缩参数 ────────────────────────────────────────────────────
# LZMA2 压缩预设级别（0-9），越高压缩率越高但越慢
# 发布构建推荐 6~9；快速构建推荐 1~3
PORTABLE_COMPRESS_PRESET=6
# 字典大小（MB），越大压缩率越高但内存和时间消耗越大
# 推荐值：64（发布）/ 32（日常）/ 8（快速测试）
PORTABLE_DICT_SIZE_MB=32

# ── NSIS 压缩参数 ───────────────────────────────────────────────────
# 压缩算法：lzma（最小体积）/ bzip2（均衡）/ zlib（最快）
NSIS_COMPRESSOR=lzma
# 是否启用 SOLID 模式（对 lzma/bzip2 有效，可显著减小体积但更慢）
# true / false
NSIS_SOLID=true
# NSIS 字典大小（MB），仅 lzma 有效，推荐值：64（发布）/ 32（日常）
NSIS_DICT_SIZE_MB=32